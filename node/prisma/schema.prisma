generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id          Int      @id @default(autoincrement())
  firstName   String
  lastName    String
  phoneNumber String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teamPlayers TeamPlayer[]
  participatedMatches ParticipatedMatch []

  @@map("players")
}

model Team {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teamPlayers TeamPlayer[]
  participatedMatches ParticipatedMatch[]

  @@map("teams")
}

model TeamPlayer {
  teamId    Int
  playerId  Int
  createdAt DateTime @default(now())

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([teamId, playerId])
  @@map("teamPlayers")
}

model Match {
  id                     Int              @id @default(autoincrement())
  type                   MatchType
  matchDate              DateTime
  participant1Id         Int
  participant1Type       ParticipantType
  participant2Id         Int
  participant2Type       ParticipantType
  finalScore             String?
  winningParticipantId   Int?
  winningParticipantType ParticipantType?
  durationInMs           Int?
  status                 MatchStatus      @default(INCOMPLETE)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  participatedMatches ParticipatedMatch []
  sets Set[]

  @@map("matches")
}

model ParticipatedMatch {
  id            Int             @id @default(autoincrement())
  matchId       Int
  participantId Int
  participantType ParticipantType
  
  match   Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player  Player? @relation(fields: [participantId], references: [id], onDelete: Cascade, map: "participated_match_player_fkey")
  team    Team?   @relation(fields: [participantId], references: [id], onDelete: Cascade, map: "participated_match_team_fkey")

  @@map("participated_matches")
}

model Set {
  id                     Int              @id @default(autoincrement())
  matchId                Int
  finalScore             String?
  winningParticipantId   Int?
  winningParticipantType ParticipantType?
  durationInMs           Int?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  games Game[]

  @@map("sets")
}

model Game {
  id                     Int              @id @default(autoincrement())
  setId                  Int
  finalScore             String?
  winningParticipantId   Int?
  winningParticipantType ParticipantType?
  durationInMs           Int?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  set Set @relation(fields: [setId], references: [id], onDelete: Cascade)

  // One-to-many with Point
  points Point[]

  @@map("games")
}

model Point {
  id                     Int             @id @default(autoincrement())
  gameId                 Int
  winningParticipantId   Int
  winningParticipantType ParticipantType
  gameScoreBefore        String?
  gameScoreAfter         String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@map("points")
}

enum MatchType {
  SINGLES
  DOUBLES
}

enum MatchStatus {
  INCOMPLETE
  COMPLETE
}

enum ParticipantType {
  PLAYER
  TEAM
}
