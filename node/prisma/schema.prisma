generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id          Int      @id @default(autoincrement())
  firstName   String
  lastName    String
  phoneNumber String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  matchesAsPlayer1 Match[]      @relation("player1Matches")
  matchesAsPlayer2 Match[]      @relation("player2Matches")
  TeamPlayer       TeamPlayer[]

  @@map("players")
}

model Team {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matchesAsTeam1 Match[]      @relation("team1Matches")
  matchesAsTeam2 Match[]      @relation("team2Matches")
  TeamPlayer     TeamPlayer[]

  @@map("teams")
}

model TeamPlayer {
  teamId    Int
  playerId  Int
  createdAt DateTime @default(now())

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([teamId, playerId])
  @@map("team_players")
}

model Match {
  id           Int       @id @default(autoincrement())
  type         MatchType
  matchDate    DateTime  @default(now())
  finalScore   String?
  winnerId     Int?
  durationInMs Int?
  status       Status    @default(INCOMPLETE)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  player1Id Int?
  player2Id Int?
  team1Id   Int?
  team2Id   Int?

  player1 Player? @relation("player1Matches", fields: [player1Id], references: [id])
  player2 Player? @relation("player2Matches", fields: [player2Id], references: [id])
  team1   Team?   @relation("team1Matches", fields: [team1Id], references: [id])
  team2   Team?   @relation("team2Matches", fields: [team2Id], references: [id])
  sets    Set[]

  @@map("matches")
}

model Set {
  id            Int      @id @default(autoincrement())
  matchId       Int
  finalScore    String?
  tiebreakScore String?
  winnerId      Int?
  durationInMs  Int?
  status        Status   @default(INCOMPLETE)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  match Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  games Game[]

  @@map("sets")
}

model Game {
  id                 Int      @id @default(autoincrement())
  setId              Int
  numberOfAdvantages Int?
  winnerId           Int?
  serverId           Int
  durationInMs       Int?
  status             Status   @default(INCOMPLETE)
  startTime          DateTime
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  set    Set     @relation(fields: [setId], references: [id], onDelete: Cascade)
  points Point[]

  @@map("games")
}

model Point {
  id              Int      @id @default(autoincrement())
  gameId          Int
  winnerId        Int
  gameScoreBefore String?
  gameScoreAfter  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@map("points")
}

enum MatchType {
  SINGLES
  DOUBLES
}

enum Status {
  INCOMPLETE
  COMPLETE
}
